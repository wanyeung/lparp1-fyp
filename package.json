{
  "name": "mlscript-studio",
  "displayName": "MLscript Studio",
  "description": "Code, table, and chart views for MLscript. The .mls file stays the source of truth.",
  "version": "0.6.1",
  "publisher": "mlscript-studio",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Programming Languages", "Visualization"],
  "activationEvents": [
    "onLanguage:mlscript",
    "onCommand:mlscriptStudio.openViews",
    "onCommand:mlscriptStudio.openUseCase"
  ],
  "main": "./src/extension.cjs",
  "contributes": {
    "commands": [
      {
        "command": "mlscriptStudio.openInfoView",
        "title": "MLscript: Open InfoView",
        "icon": "$(info)"
      },
      {
        "command": "mlscriptStudio.openGridView",
        "title": "MLscript: Open GridView",
        "icon": "$(table)"
      },
      {
        "command": "mlscriptStudio.openChartView",
        "title": "MLscript: Open ChartView",
        "icon": "$(graph)"
      },
      {
        "command": "mlscriptStudio.openViews",
        "title": "MLscript: Open Info, Grid, and Chart"
      },
      {
        "command": "mlscriptStudio.openUseCase",
        "title": "MLscript: Open Use Case"
      }
    ],
    "keybindings": [
      {
        "command": "mlscriptStudio.openViews",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m",
        "when": "editorLangId == mlscript"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "mlscriptStudio.openViews",
          "group": "navigation",
          "when": "resourceLangId == mlscript"
        }
      ],
      "explorer/context": [
        {
          "command": "mlscriptStudio.openViews",
          "group": "navigation",
          "when": "resourceExtname == .mls"
        }
      ]
    },
    "configuration": {
      "title": "MLscript Studio",
      "properties": {
        "mlscriptStudio.debounceMs": {
          "type": "number",
          "default": 120,
          "description": "Wait this long after an edit before refreshing the table and chart projection."
        }
      }
    },
    "languages": [
      {
        "id": "mlscript",
        "aliases": ["MLscript", "mlscript"],
        "extensions": [".mls"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "mlscript",
        "scopeName": "source.mlscript",
        "path": "./syntaxes/mlscript.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "preview": "node scripts/preview.mjs"
  }
}

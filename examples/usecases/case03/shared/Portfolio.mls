import "../../../../library/Studio.mls"
open Studio

module Portfolio with
  // Synthetic illustrative demo inputs, NOT live market or historical observations.
  // Edit one monthly return here; both Analysis.mls and Summary.mls import this module.
  // Row schema: [sequential month, equity total return (%), bond total return (%)].
  val monthlyAssetReturnsPercent = [
    [1, 3.2, 0.7],
    [2, -4.5, 0.4],
    [3, -6.0, -0.8],
    [4, 2.4, 0.5],
    [5, 4.6, 0.9],
    [6, 1.1, 0.3],
    [7, -3.7, -0.4],
    [8, 5.2, 1.0],
    [9, 2.8, 0.6],
    [10, -1.9, 0.2],
    [11, 4.1, 0.8],
    [12, 2.6, 0.4],
    [13, -5.4, -0.6],
    [14, -2.2, 0.1],
    [15, 3.9, 0.7],
    [16, 4.7, 0.5],
    [17, 1.5, 0.4],
    [18, 2.3, 0.6]
  ]

  // Editable assumptions: positive initial capital; equity weights in [0, 1].
  // Bond weights are computed as complements, keeping each allocation fully invested.
  val initialCapitalUsd = 100000
  val defensiveEquityWeight = 0.2
  val balancedEquityWeight = 0.6
  val growthEquityWeight = 0.8
  // Constant monthly cost in percentage points of monthly portfolio return.
  val monthlyCostPercent = 0
  // Round presentation tables only; calculations and chart series remain unrounded.
  val displayDecimals = 2

  val allocations = [
    ["Defensive", defensiveEquityWeight, 1 - defensiveEquityWeight],
    ["Balanced", balancedEquityWeight, 1 - balancedEquityWeight],
    ["Growth", growthEquityWeight, 1 - growthEquityWeight]
  ]
  val allocationIndexes = [0, 1, 2]

  fun roundDisplay(value) = Math.round(value * Math.pow(10, displayDecimals)) / Math.pow(10, displayDecimals)
  fun monthlyPortfolioPercent(row, allocation) = row.1 * allocation.1 + row.2 * allocation.2 - monthlyCostPercent
  fun nextWealth(previous, row, allocation) = previous.1 * (1 + monthlyPortfolioPercent(row, allocation) / 100)
  fun runningPeak(previous, wealth) = if wealth > previous.2 then wealth else previous.2
  // State schema: [month, wealth USD, peak USD, cumulative return %, drawdown %].
  fun makeState(month, wealth, peak) = [month, wealth, peak, 100 * (wealth / initialCapitalUsd - 1), 100 * (wealth / peak - 1)]
  fun advance(previous, row, allocation) = makeState(row.0, nextWealth(previous, row, allocation), runningPeak(previous, nextWealth(previous, row, allocation)))
  // Reset to the same target weights at the start of each month (monthly rebalancing).
  // W_t = W_(t-1) * (1 + r_t/100); month 0 enters the peak, so early losses count.
  fun simulate(allocation) = monthlyAssetReturnsPercent.reduce((path, row) => [...path, advance(path.at(-1), row, allocation)], [[0, initialCapitalUsd, initialCapitalUsd, 0, 0]])
  val allocationPaths = allocations.map(allocation => simulate(allocation))
  val monthNumbers = [0, ...monthlyAssetReturnsPercent.map(row => row.0)]

  fun monthlyComparisonRow(row) = [row.0, roundDisplay(monthlyPortfolioPercent(row, allocations.0)), roundDisplay(monthlyPortfolioPercent(row, allocations.1)), roundDisplay(monthlyPortfolioPercent(row, allocations.2))]
  fun cumulativeComparisonRow(index) = [monthNumbers.at(index), allocationPaths.0.at(index).3, allocationPaths.1.at(index).3, allocationPaths.2.at(index).3]
  fun drawdownComparisonRow(index) = [monthNumbers.at(index), allocationPaths.0.at(index).4, allocationPaths.1.at(index).4, allocationPaths.2.at(index).4]
  fun monthIndexes(n) = if n <= 0 then [0] else [...monthIndexes(n - 1), n]
  val pathIndexes = monthIndexes(monthlyAssetReturnsPercent.length)
  val comparisonHeaders = ["Month", allocations.0.0, allocations.1.0, allocations.2.0]
  val lineColumns = [allocations.0.0, allocations.1.0, allocations.2.0]

  fun worstDrawdownPercent(path) = path.reduce((worst, state) => if state.4 < worst then state.4 else worst, 0)
  fun endingRow(index) = [allocations.at(index).0, 100 * allocations.at(index).1, 100 * allocations.at(index).2, roundDisplay(allocationPaths.at(index).at(-1).1), roundDisplay(allocationPaths.at(index).at(-1).3), roundDisplay(worstDrawdownPercent(allocationPaths.at(index)))]

  val disclosure = CreateText("c03-disclosure", "Synthetic illustrative portfolio demo", "These monthly returns are invented educational inputs, not live market data, historical observations, forecasts, or investment advice. Two documents reuse one shared input series and calculation module.")
  val method = CreateText("c03-method", "Method and units", "Weights are fixed targets and restored at the start of every month, not buy-and-hold drifting weights. Returns are monthly total-return percentages with reinvestment assumed; net return is equity weight times equity return plus bond weight times bond return minus monthlyCostPercent. Wealth compounds without intermediate rounding. Cumulative return (%) = 100 * (wealth / initial capital - 1). Drawdown (%) = 100 * (wealth / running peak - 1), with month 0 included in the peak. Maximum drawdown is the most negative drawdown, not an absolute loss amount. No taxes, leverage, deposits, withdrawals, or additional trading frictions are modeled. In the combined Studio workspace, green assumption and asset-return cells are editable; editing one patches this shared Portfolio.mls module, rebuilds and refreshes both Analysis and Summary.")
  val summaryNote = CreateText("c03-summary-note", "Manager brief: illustrative, not a recommendation", "Synthetic monthly total returns; three fully invested equity/bond allocations, rebalanced monthly and compounded. The shared assumptions define initial capital and a constant monthly cost. Drawdowns include the initial capital peak; figures are rounded only for display. Analysis.mls contains the full source tables and methodology. The same green Portfolio cells can be edited from either document; both open views rebuild from the shared module.")

  val assumptionsTable = CreateCell("c03-assumptions", "Editable assumptions (green cells patch this module)", ["Parameter", "Value", "Unit / meaning"], [
    ["initialCapitalUsd", initialCapitalUsd, "USD, positive"],
    ["defensiveEquityWeight", defensiveEquityWeight, "Equity fraction, 0-1; bond weight is its complement"],
    ["balancedEquityWeight", balancedEquityWeight, "Equity fraction, 0-1; bond weight is its complement"],
    ["growthEquityWeight", growthEquityWeight, "Equity fraction, 0-1; bond weight is its complement"],
    ["monthlyCostPercent", monthlyCostPercent, "Monthly return percentage points"],
    ["displayDecimals", displayDecimals, "Displayed decimal places"],
    ["months", monthlyAssetReturnsPercent.length, "Sequential synthetic months"]
  ])
  val allocationTable = CreateCell("c03-allocations", "Fixed target allocations (monthly rebalancing)", ["Allocation", "Equity weight (%)", "Bond weight (%)"], allocations.map(allocation => [allocation.0, 100 * allocation.1, 100 * allocation.2]))
  val assetReturnsTable = CreateCell("c03-asset-returns", "Shared synthetic monthly asset returns (%)", ["Month", "Equity (%)", "Bond (%)"], monthlyAssetReturnsPercent)
  val portfolioReturnsTable = DeriveCell("c03-portfolio-returns", "Net monthly portfolio returns (%)", assetReturnsTable, comparisonHeaders, monthlyAssetReturnsPercent.map(row => monthlyComparisonRow(row)))
  val cumulativeReturnsTable = DeriveCell("c03-cumulative-returns", "Compounded cumulative returns (%) — month 0 is the baseline", portfolioReturnsTable, comparisonHeaders, pathIndexes.map(index => cumulativeComparisonRow(index)))
  val drawdownTable = DeriveCell("c03-drawdowns", "Drawdowns from running peak (%) — negative is below peak", cumulativeReturnsTable, comparisonHeaders, pathIndexes.map(index => drawdownComparisonRow(index)))
  val endingFiguresTable = DeriveCell("c03-ending-figures", "Ending figures — same shared calculations in both documents", drawdownTable, ["Allocation", "Equity (%)", "Bond (%)", "Ending value (USD)", "Cumulative return (%)", "Maximum drawdown (%)"], allocationIndexes.map(index => endingRow(index)))
  val cumulativeChart = LineChart("c03-cumulative-chart", "Cumulative return (%) — three allocation overlay", cumulativeReturnsTable, "Month", lineColumns)
  val drawdownChart = LineChart("c03-drawdown-chart", "Drawdown (%) — three allocation overlay", drawdownTable, "Month", lineColumns)

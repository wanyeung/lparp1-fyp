// @studio Financial analysis — three-month cashflow
// January, February, and March share one opening balance. The statement
// case carries that balance forward. The spending case splits the same
// money into months, categories, and a check that the two lists agree.

// @document Cashflow statement
// id: statement
// includes: document:opening-balance, document:running-balance
// @enddocument

// @document Opening balance
// id: opening-balance
// includes: doc:opening-balance, table:assumptions
// @enddocument

// @document Running balance
// id: running-balance
// includes: doc:running-balance, table:cashflow, chart:net
// @enddocument

// @document Income and spending
// id: spending
// includes: document:monthly-cash, document:spending-categories, document:check-totals
// @enddocument

// @document Monthly cash
// id: monthly-cash
// includes: doc:monthly-cash, table:months, chart:income
// @enddocument

// @document Spending categories
// id: spending-categories
// includes: doc:spending-categories, table:expenses, chart:categories
// @enddocument

// @document Check the two lists
// id: check-totals
// includes: doc:check-totals, table:reconciled
// @enddocument

// @doc Where the quarter starts
// id: opening-balance
// The books open at 2000. That literal is added once, on the January row.
// February and March do not add it again; they inherit the balance that
// January already produced.
// @enddoc

// @doc Net and the balance that follows
// id: running-balance
// Net is income minus expenses for that month: 1100, 1400, and 900.
// The balance is the opening 2000 plus every net so far: 3100, 4500, 5400.
// Both columns are formulas, so the net chart cannot be dragged.
// @enddoc

// @doc Three months of literals
// id: monthly-cash
// January and February each take in 4200. March takes in 4500.
// Spending on the month rows is 3100, 2800, and 3600. The income bars
// edit those income literals directly.
// @enddoc

// @doc Rent, food, and transport
// id: spending-categories
// The same quarter of spending is also stored by category: rent 6000,
// food 2100, and transport 1400. Those are literals, so the category
// chart can be dragged. They are not a third copy of the month rows.
// @enddoc

// @doc Both totals should read 9500
// id: check-totals
// Category amounts add to 9500. The three month expense figures add to
// 9500 as well. If one side changes and the other does not, this row
// is how you see the two lists diverge.
// @enddoc

// @chart Net by month
// id: net
// type: bar
// source: cashflow
// x: month
// y: net
// @endchart

// @chart Income by month
// id: income
// type: bar
// source: months
// x: month
// y: income
// @endchart

// @chart Spending by category
// id: categories
// type: bar
// source: expenses
// x: category
// y: amount
// @endchart

module FinancialAnalysis with
  let assumptions = mut { opening: 2000 }

  let months = [
    mut { month: "Jan", income: 4200, expenses: 3100 },
    mut { month: "Feb", income: 4200, expenses: 2800 },
    mut { month: "Mar", income: 4500, expenses: 3600 }
  ]

  let expenses = [
    mut { category: "Rent", amount: 6000 },
    mut { category: "Food", amount: 2100 },
    mut { category: "Transport", amount: 1400 }
  ]

  let cashflow = [
    mut {
      month: months.0.month,
      income: months.0.income,
      expenses: months.0.expenses,
      net: months.0.income - months.0.expenses,
      balance: assumptions.opening + months.0.income - months.0.expenses
    },
    mut {
      month: months.1.month,
      income: months.1.income,
      expenses: months.1.expenses,
      net: months.1.income - months.1.expenses,
      balance: assumptions.opening + months.0.income - months.0.expenses + months.1.income - months.1.expenses
    },
    mut {
      month: months.2.month,
      income: months.2.income,
      expenses: months.2.expenses,
      net: months.2.income - months.2.expenses,
      balance: assumptions.opening + months.0.income - months.0.expenses + months.1.income - months.1.expenses + months.2.income - months.2.expenses
    }
  ]

  let reconciled = [
    mut {
      categoryTotal: expenses.0.amount + expenses.1.amount + expenses.2.amount,
      monthTotal: months.0.expenses + months.1.expenses + months.2.expenses
    }
  ]

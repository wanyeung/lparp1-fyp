module Csv with

  fun value(text) =
    let t = text.trim()
    if t != "" && globalThis.Number.isFinite(globalThis.Number(t)) then globalThis.Number(t) else text

  fun parse(text) =
    let rows = mut []
    let row = mut []
    let field = ""
    let quoted = false
    let i = 0
    let n = text.length
    while i < n do
      let ch = text.charAt(i)
      if quoted then
        if ch == "\"" && text.charAt(i + 1) == "\"" then
          set field = field + "\""
          set i = i + 1
        else if ch == "\"" then set quoted = false
        else set field = field + ch
      else if ch == "\"" then set quoted = true
      else if ch == "," then
        row.push(value(field))
        set field = ""
      else if ch == "\n" then
        row.push(value(field))
        rows.push(row)
        set row = mut []
        set field = ""
      else if ch == "\r" then ()
      else set field = field + ch
      set i = i + 1
    if field != "" || row.length > 0 then
      row.push(value(field))
      rows.push(row)
    else ()
    rows

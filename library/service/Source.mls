module Source with

  fun isSpace(c) = c == " " || c == "\t" || c == "\n" || c == "\r"

  // Offset of the top-level `val name =` line, or -1.
  fun position(source, name) = ("\n" + source).indexOf("\nval " + name + " =")

  fun importedFiles(source) =
    source.split("\n").filter(line => line.startsWith("import \"")).map(line => line.slice(8, line.lastIndexOf("\"")))

  fun moduleOf(file) = file.slice(file.lastIndexOf("/") + 1).replace(".mls", "")

  fun skip(source, from) =
    let i = from
    let inComment = false
    let going = true
    while going && i < source.length do
      let ch = source.charAt(i)
      if inComment then
        if ch == "\n" then set inComment = false else ()
        set i = i + 1
      else if ch == "/" && source.charAt(i + 1) == "/" then
        set inComment = true
        set i = i + 2
      else if isSpace(ch) then set i = i + 1
      else set going = false
    i

  // End of the value that starts at `from`: counts brackets, skips strings and comments, and stops at a comma or line break at depth 0.
  fun valueEnd(source, from) =
    let j = from
    let last = from
    let depth = 0
    let inString = false
    let inComment = false
    let done = false
    while done == false && j < source.length do
      let ch = source.charAt(j)
      if inComment then
        if ch == "\n" then
          set inComment = false
          if depth == 0 then set done = true else ()
        else ()
      else if inString then
        if ch == "\\" then set j = j + 1
        else if ch == "\"" then set inString = false
        else ()
        set last = j + 1
      else if ch == "/" && source.charAt(j + 1) == "/" then set inComment = true
      else if ch == "\"" then
        set inString = true
        set last = j + 1
      else if ch == "[" || ch == "{" || ch == "(" then
        set depth = depth + 1
        set last = j + 1
      else if ch == "]" || ch == "}" || ch == ")" then
        if depth == 0 then set done = true
        else
          set depth = depth - 1
          set last = j + 1
      else if depth == 0 && (ch == "," || ch == "\n") then set done = true
      else if isSpace(ch) == false then set last = j + 1
      else ()
      set j = j + 1
    last

  // The import path a val takes its value from (`val x = table.grid`), or "" if it is defined here.
  fun origin(source, name) =
    let v = bindingValue(source, name)
    let id = if v < 0 then "" else identAt(source, v)
    let hits = importedFiles(source).filter(f => moduleOf(f) == id)
    if id != "" && hits.length > 0 then hits.0 else ""

  // Offset where the value of `val name =` starts, or -1.
  fun bindingValue(source, name) =
    let pos = position(source, name)
    if pos < 0 then -1 else skip(source, pos + ("val " + name + " =").length)

  // Goes through an array literal element by element, skipping the others, and follows the rest of the path into element `index`.
  fun inArray(source, from, index, rest) =
    let i = skip(source, from)
    let k = 0
    let result = null
    let going = true
    while going && i < source.length && source.charAt(i) != "]" do
      if k == index then
        set result = descend(source, i, rest)
        set going = false
      else
        let e = valueEnd(source, i)
        if e == i then set going = false
        else
          set i = skip(source, e)
          if source.charAt(i) == "," then set i = skip(source, i + 1) else ()
          set k = k + 1
    result

  // Same for a record: reads each `key:`, skips the other fields, and follows the rest of the path into `key`.
  fun inRecord(source, from, key, rest) =
    let i = skip(source, from)
    let result = null
    let going = true
    while going && i < source.length && source.charAt(i) != "}" do
      let field = identAt(source, i)
      let colon = skip(source, i + field.length)
      if field == "" || source.charAt(colon) != ":" then set going = false
      else
        let v = skip(source, colon + 1)
        if field == key then
          set result = descend(source, v, rest)
          set going = false
        else
          let e = valueEnd(source, v)
          if e == v then set going = false
          else
            set i = skip(source, e)
            if source.charAt(i) == "," then set i = skip(source, i + 1) else ()
    result

  // One step of a path: a number goes into an array, a name goes into a record. With no steps left it returns the literal span.
  fun descend(source, from, steps) =
    let s = skip(source, from)
    if steps.length == 0 then [s, valueEnd(source, s)]
    else
      let step = steps.0
      let rest = steps.slice(1)
      let c = source.charAt(s)
      let isIndex = globalThis.Number.isFinite(step)
      if c == "[" && isIndex then inArray(source, s + 1, step, rest)
      else if c == "{" && isIndex == false then inRecord(source, s + 1, globalThis.String(step), rest)
      else null

  // The [start, end] of the literal that a path points at in the text, or null. This is how a cell is found.
  fun locate(source, path) =
    let v = bindingValue(source, path.0)
    if v < 0 then null else descend(source, v, path.slice(1))

  fun isIdent(c) = (c >= "a" && c <= "z") || (c >= "A" && c <= "Z") || (c >= "0" && c <= "9") || c == "_"

  // The identifier under the cursor offset.
  fun word(source, offset) =
    let a = offset
    let b = offset
    while a > 0 && isIdent(source.charAt(a - 1)) do set a = a - 1
    while b < source.length && isIdent(source.charAt(b)) do set b = b + 1
    source.slice(a, b)

  fun identAt(text, i) =
    let j = i
    while j < text.length && isIdent(text.charAt(j)) do set j = j + 1
    text.slice(i, j)

  fun declName(line) =
    if line.startsWith("val ") then identAt(line, 4)
    else if line.startsWith("fun ") then identAt(line, 4)
    else ""

  // The `val` or `fun` declaration that contains the cursor offset: its name and text span.
  fun range(source, offset) =
    let lines = source.split("\n")
    let pos = 0
    let i = 0
    let name = ""
    let from = 0
    let to = source.length
    let done = false
    while i < lines.length && done == false do
      let line = lines.at(i)
      let decl = declName(line)
      if decl != "" then
        if pos > offset then
          set to = pos
          set done = true
        else
          set name = decl
          set from = pos
      else ()
      set pos = pos + line.length + 1
      set i = i + 1
    { name: name, from: from, to: to }

  // True if `name` appears in the text as a whole word.
  fun mentions(text, name) =
    let i = text.indexOf(name)
    let hit = false
    while i >= 0 && hit == false do
      let before = if i == 0 then " " else text.charAt(i - 1)
      let after = text.charAt(i + name.length)
      if isIdent(before) == false && isIdent(after) == false then set hit = true
      else set i = text.indexOf(name, i + 1)
    hit

  fun blankLine(source, offset) =
    let head = if offset == 0 then 0 else source.lastIndexOf("\n", offset - 1) + 1
    let tail = source.indexOf("\n", offset)
    let stop = if tail < 0 then source.length else tail
    source.slice(head, stop).trim() == ""

module Source with

  fun isSpace(c) = c == " " || c == "\t" || c == "\n" || c == "\r"

  fun position(source, name) = ("\n" + source).indexOf("\nval " + name + " =")

  fun start(source, name) =
    let pos = position(source, name)
    if pos < 0 then -1 else source.indexOf("[", pos)

  fun locate(source, name, row, col) =
    let lb = start(source, name)
    let n = source.length
    let i = lb
    let depth = 0
    let inString = false
    let inComment = false
    let r = -1
    let c = 0
    let atom = -1
    let last = -1
    let found = null
    while lb >= 0 && i < n && found is null do
      let ch = source.charAt(i)
      if inComment then
        if ch == "\n" then set inComment = false else ()
      else if inString then
        if ch == "\\" then set i = i + 1
        else if ch == "\"" then
          set inString = false
          set last = i
        else ()
      else if ch == "/" && source.charAt(i + 1) == "/" then set inComment = true
      else if ch == "\"" then
        set inString = true
        if depth == 2 && atom < 0 then set atom = i else ()
      else if ch == "[" then
        set depth = depth + 1
        if depth == 2 then
          set r = r + 1
          set c = 0
          set atom = -1
        else ()
      else if ch == "]" || ch == "," then
        if depth == 2 && atom >= 0 then
          if r == row && c == col then set found = [atom, last + 1] else ()
          set atom = -1
        else ()
        if ch == "," && depth == 2 then set c = c + 1 else ()
        if ch == "]" then set depth = depth - 1 else ()
        if depth == 0 then set i = n else ()
      else if isSpace(ch) == false then
        if depth == 2 && atom < 0 then set atom = i else ()
        if depth == 2 then set last = i else ()
      else ()
      set i = i + 1
    found

  fun isIdent(c) = (c >= "a" && c <= "z") || (c >= "A" && c <= "Z") || (c >= "0" && c <= "9") || c == "_"

  fun word(source, offset) =
    let a = offset
    let b = offset
    while a > 0 && isIdent(source.charAt(a - 1)) do set a = a - 1
    while b < source.length && isIdent(source.charAt(b)) do set b = b + 1
    source.slice(a, b)

  fun identAt(text, i) =
    let j = i
    while j < text.length && isIdent(text.charAt(j)) do set j = j + 1
    text.slice(i, j)

  fun declName(line) =
    if line.startsWith("val ") then identAt(line, 4)
    else if line.startsWith("fun ") then identAt(line, 4)
    else ""

  fun range(source, offset) =
    let lines = source.split("\n")
    let pos = 0
    let i = 0
    let name = ""
    let from = 0
    let to = source.length
    let done = false
    while i < lines.length && done == false do
      let line = lines.at(i)
      let decl = declName(line)
      if decl != "" then
        if pos > offset then
          set to = pos
          set done = true
        else
          set name = decl
          set from = pos
      else ()
      set pos = pos + line.length + 1
      set i = i + 1
    { name: name, from: from, to: to }

  fun mentions(text, name) =
    let i = text.indexOf(name)
    let hit = false
    while i >= 0 && hit == false do
      let before = if i == 0 then " " else text.charAt(i - 1)
      let after = text.charAt(i + name.length)
      if isIdent(before) == false && isIdent(after) == false then set hit = true
      else set i = text.indexOf(name, i + 1)
    hit

  fun blankLine(source, offset) =
    let head = if offset == 0 then 0 else source.lastIndexOf("\n", offset - 1) + 1
    let tail = source.indexOf("\n", offset)
    let stop = if tail < 0 then source.length else tail
    source.slice(head, stop).trim() == ""

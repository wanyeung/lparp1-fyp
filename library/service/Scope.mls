import "./Source.mls"
import "../model/Document.mls"

module Scope with

  fun names(source, offset, available) =
    let w = Source.word(source, offset)
    if Source.blankLine(source, offset) then []
    else if available.includes(w) then [w]
    else
      let r = Source.range(source, offset)
      if r.name == "" then []
      else if available.includes(r.name) then [r.name]
      else available.filter(n => Source.mentions(source.slice(r.from, r.to), n))

  fun view(tree, source, offset) =
    let picked = names(source, offset, Document.names(tree))
    { names: picked, tree: Document.focus(tree, picked) }

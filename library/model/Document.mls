import "./Primitive.mls"

module Document with

  fun use(name) = { kind: "import", name: name, title: name }

  fun useAs(name, title) = { kind: "import", name: name, title: title }

  fun text(markdown) = { kind: "markdown", text: markdown }

  fun custom(name, file, entries) = { name: name, file: file, entries: entries }

  fun hidden(p) = p.name.startsWith("_")

  fun ofFile(file, primitives) = custom(file, file, primitives.filter(p => hidden(p) == false).map(p => use(p.name)))

  fun forFile(documents, file) = documents.filter(d => d.file == file)

  fun chart(family, title, source, x, ys) =
    { kind: "chart", chart: family, title: title, source: source, x: x, ys: ys }

  fun missing(name) = { kind: "missing", name: name, title: name }

  fun column(grid, y) =
    let col = grid.headers.indexOf(y)
    { name: y, values: grid.rows.map(row => row.at(col)), paths: grid.rows.map((row, r) => if Primitive.imported(grid) then null else Primitive.cellPath(grid, r, col)) }

  fun chartNode(name, title, spec, available) =
    let hits = Primitive.find(available, spec.source).filter(p => p.kind == "table")
    if hits.length == 0 then missing(name)
    else if hits.0.headers.indexOf(spec.x) < 0 then missing(name)
    else
      { kind: "chart", name: name, title: title, path: [name], chart: spec.chart, source: spec.source, x: spec.x,
        labels: hits.0.rows.map(row => row.at(hits.0.headers.indexOf(spec.x))),
        series: spec.ys.map(y => column(hits.0, y)) }

  fun resolve(p, title, available) =
    if p.kind == "chart" then chartNode(p.name, title, p.spec, available)
    else { ...p, title: title, children: p.children.map(c => resolve(c, c.title, available)) }

  fun item(entry, available) =
    if entry.kind == "markdown" then { kind: "text", text: entry.text }
    else if entry.kind == "chart" then chartNode(entry.title, entry.title, entry, available)
    else
      let hits = Primitive.find(available, entry.name)
      if hits.length == 0 then missing(entry.name) else resolve(hits.0, entry.title, available)

  fun tree(document, available) =
    { kind: "document", name: document.name, title: document.name, path: [], file: document.file,
      children: document.entries.map(entry => item(entry, available)) }

  fun named(node) =
    if node.path is Array then globalThis.Number.isFinite(node.path.at(node.path.length - 1)) == false else false

  fun namesOf(node) =
    let own = if named(node) then [node.name] else []
    if node.children is Array then own.concat(namesIn(node.children)) else own

  fun namesIn(nodes) = nodes.flatMap(node => namesOf(node))

  fun names(tree) = namesIn(tree.children)

  fun hit(node, picked) =
    if picked.includes(node.name) then true
    else if node.kind == "chart" then picked.includes(node.source)
    else false

  fun prune(node, picked) =
    if hit(node, picked) then [node]
    else if node.children is Array then
      let kept = focusAll(node.children, picked)
      if kept.length == 0 then [] else [{ ...node, children: kept }]
    else []

  fun focusAll(nodes, picked) = nodes.flatMap(node => prune(node, picked))

  fun focus(tree, picked) =
    let kept = focusAll(tree.children, picked)
    if picked.length == 0 then tree
    else if kept.length == 0 then tree
    else { ...tree, children: kept }

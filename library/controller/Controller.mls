import "../model/Primitive.mls"
import "../model/Document.mls"
import "../service/Source.mls"
import "../service/SourceEdit.mls"
import "../service/Scope.mls"

module Controller with

  fun primitives(payload) =
    globalThis.Object.entries(payload.exports)
      .filter(entry => entry.0.startsWith("_$_modulePrivate_$_"))
      .filter(entry => (entry.1 is Function) == false)
      .map(entry => Primitive.make(entry.0.slice(19), entry.1))
      .map(p => Primitive.withOrigin(p, Source.origin(payload.source, p.name)))
      .sort((a, b) => Source.position(payload.source, a.name) - Source.position(payload.source, b.name))

  fun document(payload) = Document.ofFile(payload.file, primitives(payload))

  fun tree(document, primitives) = Document.tree(document, primitives)

  fun edit(payload) =
    if payload.header == true then SourceEdit.header(payload.source, payload.path, payload.kind, payload.col, payload.text)
    else SourceEdit.at(payload.source, Primitive.cellPath(payload, payload.row, payload.col), payload.text)

  fun move(payload) = SourceEdit.move(payload.source, payload.name, payload.dir)

  fun scope(tree, source, offset) = Scope.view(tree, source, offset)

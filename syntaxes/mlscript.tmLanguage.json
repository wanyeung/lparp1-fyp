{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "MLscript",
  "scopeName": "source.mlscript",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#numbers" },
    { "include": "#studio" },
    { "include": "#types" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.mlscript", "match": "//.*$" },
        { "name": "comment.block.mlscript", "begin": "/\\*", "end": "\\*/" }
      ]
    },
    "strings": {
      "name": "string.quoted.double.mlscript",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "name": "constant.character.escape.mlscript", "match": "\\\\." }
      ]
    },
    "keywords": {
      "name": "keyword.control.mlscript",
      "match": "\\b(?:module|import|export|open|with|fun|val|let|mut|if|then|else|match|case|class|type|declare|new|extends|is|and|or|not)\\b"
    },
    "numbers": {
      "name": "constant.numeric.mlscript",
      "match": "\\b(?:0[xX][0-9a-fA-F]+|[0-9]+(?:\\.[0-9]+)?)\\b"
    },
    "studio": {
      "patterns": [
        { "name": "support.function.studio.mlscript", "match": "\\b(?:CreateCell|CreatCell|DeriveCell|CreateGroup|CreateText|BarChart|PieChart|LineChart|Display|DisplayOrdered|Model|ModelOrdered)\\b" }
      ]
    },
    "types": {
      "name": "entity.name.type.mlscript",
      "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
    }
  }
}

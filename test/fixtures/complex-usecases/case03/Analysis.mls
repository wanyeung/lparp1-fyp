import "./shared/Portfolio.mls"

val disclosure = "# Portfolio comparison: analyst working report, Jan 2025 to Jun 2026\nThese monthly returns are invented educational inputs, not market data, forecasts or investment advice. This report and the manager brief (Summary.mls) read the same shared inputs and calculations, so to change a value, edit shared/Portfolio.mls."

val inputsHeading = "# 1. Inputs\nStarting capital, a constant monthly cost, three fixed target allocations and 18 months of equity and bond total returns. Weights are restored at the start of every month (monthly rebalancing); each allocation's equity and bond weights should add up to 100%. No taxes, leverage, deposits or withdrawals are modelled."

val assumptions = Portfolio.assumptions

val allocations = Portfolio.allocationTargets

val assetReturns = Portfolio.assetReturns

val monthlyHeading = "# 2. Monthly returns\nEach allocation's monthly return (%) = equity weight x equity return + bond weight x bond return - monthly cost."

val portfolioReturns = Portfolio.portfolioReturns

val growthHeading = "# 3. Growth\nWealth compounds month by month without intermediate rounding. Cumulative return (%) = 100 x (wealth / starting capital - 1); Start is the opening balance."

val cumulativeReturns = Portfolio.cumulativeReturns

val cumulativeChart = { chart: "Line", source: "cumulativeReturns", x: "Month", ys: ["Defensive (%)", "Balanced (%)", "Growth (%)"] }

val riskHeading = "# 4. Risk\nDrawdown (%) = 100 x (wealth / highest wealth so far - 1). The starting balance counts as a peak, so early losses show. 0 means the allocation is at a new high."

val drawdowns = Portfolio.drawdowns

val drawdownChart = { chart: "Line", source: "drawdowns", x: "Month", ys: ["Defensive (%)", "Balanced (%)", "Growth (%)"] }

val resultsHeading = "# 5. Results\nEnding value and cumulative return after Jun 2026, and each allocation's worst drop from a peak over the period. Figures are rounded to 2 decimals for display only."

val endingFigures = Portfolio.endingFigures
